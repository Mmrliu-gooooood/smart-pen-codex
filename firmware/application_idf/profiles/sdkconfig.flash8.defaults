# Opt in explicitly after sdkconfig.defaults; this does not validate hardware.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="profiles/flash8.csv"
CONFIG_PEN_APP_FLASH8_PROFILE=y
CONFIG_PEN_FLASH_RECORDING=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# CONFIG_PEN_APP_RUN_APPROVED_PROVIDER is not set
