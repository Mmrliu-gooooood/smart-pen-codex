# COMPILE-ONLY: app_main still always returns without hardware actions.
# Signed-on-update verification branch is compiled; binary is NOT signed.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PEN_FLASH_RECORDING=y
CONFIG_PEN_OTA_ALLOW_INSTALL=y
CONFIG_PEN_OTA_PROJECT="smartpen_runtime_compile"
CONFIG_PEN_OTA_HARDWARE="smartpen_runtime_compile"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK is not set
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
# CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES is not set
# CONFIG_SECURE_BOOT is not set
