+/* Shared current-pixel phase normalization; no decoded symbols or truth. */
+static void coordinates(pen_roi_workspace *ws,int n,double pitch,double cs,double sn,double ratio,
+ double *origin_x,double *origin_y){
+ double *u=ws->u,*v=ws->v;
+ for(int i=0;i<n;i++){
+  u[i]=(ws->points[i].x*cs+ws->points[i].y*sn)/pitch;
+  v[i]=(-ws->points[i].x*sn+ws->points[i].y*cs)/(pitch*ratio);
+ }
+ double ox=phase(u,n),oy=phase(v,n);
+ for(int iter=0;iter<3;iter++){
+  double sx=0,sy=0;int nx=0,ny=0;
+  for(int i=0;i<n;i++){
+   double dx=residual(u[i]-ox),dy=residual(v[i]-oy);
+   if(fabs(dx)>fabs(dy)){sy+=dy;ny++;}else{sx+=dx;nx++;}
+  }
+  if(nx)ox+=sx/nx;
+  if(ny)oy+=sy/ny;
+ }
+ *origin_x=ox;*origin_y=oy;
+}
