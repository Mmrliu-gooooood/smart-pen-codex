+/* All-point orthogonal anisotropic least squares. Corrected lattice positions
+ * come only from current residual directions, never a decoded codeword. */
+static int refine_geometry(pen_roi_workspace *ws,int n,pen_roi_refine_seed *s,uint32_t *iterations){
+ for(unsigned iteration=0;iteration<5;iteration++){
+  (*iterations)++;
+  double cs=cos(s->angle*PI/180),sn=sin(s->angle*PI/180),ox,oy;
+  coordinates(ws,n,s->pitch,cs,sn,s->ratio,&ox,&oy);
+  double qmx=0,qmy=0,pmx=0,pmy=0;
+  for(int i=0;i<n;i++){
+   double ix=round(ws->u[i]-ox),iy=round(ws->v[i]-oy);
+   double dx=ws->u[i]-ox-ix,dy=ws->v[i]-oy-iy;
+   ws->xx[i]=ix;ws->yy[i]=iy;
+   if(fabs(dx)>fabs(dy))ws->xx[i]+=dx<0?-1.0/6:1.0/6;
+   else ws->yy[i]+=dy<0?-1.0/6:1.0/6;
+   qmx+=ws->xx[i];qmy+=ws->yy[i];pmx+=ws->points[i].x;pmy+=ws->points[i].y;
+  }
+  qmx/=n;qmy/=n;pmx/=n;pmy/=n;
+  double xx=0,yy=0,ax=0,ay=0,bx=0,by=0;
+  for(int i=0;i<n;i++){
+   double qx=ws->xx[i]-qmx,qy=ws->yy[i]-qmy;
+   double px=ws->points[i].x-pmx,py=ws->points[i].y-pmy;
+   xx+=qx*qx;yy+=qy*qy;ax+=qx*px;ay+=qx*py;bx+=qy*px;by+=qy*py;
+  }
+  if(!isfinite(xx)||!isfinite(yy)||xx<1||yy<1)return 0;
+  double m00=ax*ax/xx+by*by/yy,m01=ax*ay/xx-by*bx/yy,m11=ay*ay/xx+bx*bx/yy;
+  /* Repeated eigenvalues leave orientation unconstrained: never choose atan2(0,0). */
+  double gap=hypot(m00-m11,2*m01);
+  if(!isfinite(gap)||gap<1e-10*(fabs(m00)+fabs(m11)+1))return 0;
+  double rad=.5*atan2(2*m01,m00-m11);cs=cos(rad);sn=sin(rad);
+  double pitch=(ax*cs+ay*sn)/xx,ypitch=(-bx*sn+by*cs)/yy;
+  double ratio=ypitch/pitch,angle=rad*180/PI;
+  if(!isfinite(pitch)||!isfinite(ratio)||!isfinite(angle)||pitch<8||pitch>32||
+     angle < -60||angle>60||ratio<.6||ratio>1.4)return 0;
+  s->pitch=pitch;s->angle=angle;s->ratio=ratio;
+ }
+ return 1;
+}
