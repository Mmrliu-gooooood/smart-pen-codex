+  d.refined_models++;
+  int rc=candidate(ws,n,cfg,seeds[i].pitch,seeds[i].angle,seeds[i].ratio,&c,NULL);
+  if(rc<0){if(diagnostics)*diagnostics=d;return rc;}
+  if(rc&&merge_candidate(&best,&c,&found)){if(diagnostics)*diagnostics=d;return PEN_ROI_AMBIGUOUS;}
+ }
+ if(diagnostics)*diagnostics=d;
