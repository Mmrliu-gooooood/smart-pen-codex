+{
+    if (out == NULL) return -1;
+    *out = 0;
+    i2c_master_dev_handle_t *handle = get_handle_from_address(slv_addr);
+    if (handle == NULL) return -1;
+    uint8_t tx[2] = {(uint8_t)(reg >> 8), (uint8_t)reg};
+    uint8_t rx = 0;
+    esp_err_t ret = i2c_master_transmit_receive(*handle, tx, 2, &rx, 1, TIMEOUT_MS);
+    if (ret != ESP_OK) return -1;
+    *out = rx;
+    return 0;
+}
